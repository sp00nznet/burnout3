# Your game data: the unpacked disc. Never committed.
Burnout 3 Takedown/
*.iso
*.xiso

# Generated from default.xbe by regen.sh. Never committed: the tool ships,
# the output doesn't.
src/game/recomp/gen/
src/game/recomp/gen.*/

# Build output (regen.sh's analysis lands in build/xr)
build/
build-xr/
out/
bin/
*.obj
*.exe
*.dll
*.lib
*.exp
*.pdb
*.ilk
*.idb

# Runtime state and captures: emulated HDD, frame dumps, logs
saves/
runs/
*.bmp
*.log
setup.log

# Made by Setup.cmd
Play Burnout 3.cmd

# Local-only
_local/
CLAUDE.md
.claude/
.mcp.json
REPO_RULES.md

