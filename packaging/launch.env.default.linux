# Launcher defaults (the native Linux build). Do not edit this file: a new
# bundle replaces it. Put your own KEY=value lines in config/launch.env
# (in the game's folder, or $BURNOUT3_ROOT); they win over these.
# Any RECOMP_* key from docs/running.md works there, e.g. RECOMP_PB_BACKEND=cpu.
# Direct3D 11 over Vulkan (DXVK-native, in lib/).
RECOMP_PB_BACKEND=d3d11
# DXVK-native's window system: the game's windows are SDL3's.
DXVK_WSI_DRIVER=SDL3
# The emulated MCPX APU DSP runs the game's own audio effects (reverb, the
# game's mix). RECOMP_APU_DSP=0 in config/launch.env goes back to the plain
# mix (the stub):
# RECOMP_APU_DSP=0
# Game logs kept in logs/.
LOG_KEEP=10
