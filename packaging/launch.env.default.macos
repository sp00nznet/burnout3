# Launcher defaults (macOS). Do not edit this file: a new app replaces it.
# Put your own KEY=value lines in
# ~/Library/Application Support/Burnout3Takedown/config/launch.env; they win
# over these. Any RECOMP_* key from docs/running.md works there, e.g.
# RECOMP_USB_PADS=1.
# The GPU through Metal, on a toolkit that has it (the xboxrecomp fork).
# Upstream's toolkit ignores the key and draws in software.
# On the fork, RECOMP_PB_BACKEND=cpu picks the software renderer.
RECOMP_PB_BACKEND=metal
# The keyboard as player 1, read only while the game window has focus.
# Controllers (through SDL) work without this.
RECOMP_KEYBOARD=1
# Game logs kept in logs/.
LOG_KEEP=10
