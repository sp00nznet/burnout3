# Copy to scripts/bench.env (untracked, never synced) for ./burnout3 bench.
# KEY=value lines; quote a host path that starts with ~ so the host expands
# it. ./burnout3 bench --help lists every key.

# The bench host (ssh target).
BENCH_HOST=user@host

# The dump already on the host: this tree gets a link to it named
# "Burnout 3 Takedown" (./burnout3 bench sync --game-files).
BENCH_GAME_FILES='~/xbox-recomp/burnout_3'

# A Wine prefix of its own, so BLiNX 2's is never touched.
BENCH_PREFIX='~/xbox-recomp/prefix-b3'
